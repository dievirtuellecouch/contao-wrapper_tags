{% trans_default_domain 'contao_default' %}

{% if as_editor_view %}
    <div class="tl_content">
        <h1 class="tl_wizard">### {{ ('CTE.' ~ type ~ '.0')|trans }} (ID: {{ data.id }}) ###</h1>
        {% if tags %}
            <ul>
                {% for tag in tags %}
                    <li>&lt;{{ tag.tag }}{% if tag.class|default %} class=&quot;{{ tag.class }}&quot;{% endif %}&gt;</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% else %}
    {%- for tag in tags -%}
        <{{ tag.tag }}{% for attribute in tag.attributes|default([]) %} {{ attribute.name|escape }}="{{ attribute.value|insert_tag|escape }}"{% endfor %}{% if tag.class|default %} class="{{ tag.class|escape }}"{% endif %}>
    {%- endfor -%}
{% endif %}
